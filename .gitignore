*.sqlite3
*.db
*.sql.gz
dump.rdb

# --- Docker / local overrides ---
docker-compose.override.yml
.devcontainer/devcontainer.local.json
*.local

# --- Project ---
.work/
dist/
staging/
*.8pv1.manifest
*.8pv1.bin
*.8pv1.imp
*.8pv1.relo
