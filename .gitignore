.vscode/
.idea/
.fleet/
.zed/
.vs/
.history/
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.swp
*.swo
*~
.#*
\#*#
.netbeans/
nbproject/

