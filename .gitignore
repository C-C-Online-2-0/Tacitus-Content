# ============================================================
# Master .gitignore template
# Source of truth: ~/.claude/gitignore-template
# Copy to a repo as .gitignore, then trim/extend per project.
# Never remove the AI / secrets sections.
# ============================================================

# --- Secrets & environment (NEVER commit) ---
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.kdbx
secrets.*
*.secret
*.secrets
credentials.json
service-account*.json
.npmrc
.pypirc
.netrc
.aws/
.ssh/
.docker/config.json
*.tfvars
*.tfstate
*.tfstate.*
.terraform/

# --- AI / agent tooling (local config, memory, rules, transcripts) ---
.claude/
CLAUDE.md
CLAUDE.local.md
.mcp.json
AGENT.md
AGENTS.md
AGENTS.override.md
GEMINI.md
QWEN.md
CRUSH.md
WARP.md
.agent/
.agents/
.codex/
.gemini/
.qwen/
.crush/
.cursor/
.cursorrules
.cursorignore
.cursorindexingignore
.windsurf/
.windsurfrules
.aider*
.continue/
.cline/
.clinerules
.clinerules/
.roo/
.roomodes
.roorules
.kilocode/
.kiro/
.trae/
.augment/
.junie/
.amazonq/
.opencode/
.goose/
.sourcegraph/
.copilot/
.github/copilot-instructions.md
.github/instructions/
.github/prompts/
.github/chatmodes/
.codeium/
.tabnine/
.specstory/
.superpowers/
.serena/
.taskmaster/
.bmad-core/
.ai/
.llm/
.prompts/
.memory/
memory-bank/
*.chat.md
*.transcript.md

