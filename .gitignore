!.yarn/plugins
!.yarn/releases
!.yarn/versions
dist/
build/
out/
target/
bin/
obj/
.next/
.nuxt/
.output/
.svelte-kit/
.astro/
.turbo/
.vercel/
.netlify/
.parcel-cache/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
coverage/
.nyc_output/
storybook-static/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
